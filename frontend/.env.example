VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=cole_a_anon_key_aqui
# Para demo com ngrok no frontend, mantenha /api e use o proxy do Vite.
VITE_API_BASE_URL=/api
# URL publica do frontend quando ele estiver exposto por ngrok.
# Exemplo: https://seu-frontend.ngrok-free.dev
VITE_PUBLIC_APP_URL=
# Backend local que o Vite vai proxiar quando /api for chamado.
VITE_BACKEND_PROXY_TARGET=http://localhost:3000
VITE_ACCESS_PORTAL_PATH=/workspace/acesso
VITE_INVITE_PORTAL_PATH=/workspace/convite
VITE_PLATFORM_PORTAL_PATH=/workspace/plataforma
