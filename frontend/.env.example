# =============================================================================
# ManuCMMS Frontend (Next.js)
# Copie para frontend/.env.local e preencha os valores reais:
#   cp .env.example .env.local
# =============================================================================

# URL base da API NestJS
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Origem pública do frontend (usada no manifest PWA para captura de links)
NEXT_PUBLIC_APP_ORIGIN=https://manucmms.vercel.app

# Supabase (mesmos valores públicos usados no backend/.env)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_a_anon_key_aqui
