# =============================================================================
# ManuCMMS — paths da documentação (SOMENTE LOCAL — não commitar)
# =============================================================================
# 1. Copie para .env.documentacao (gitignored) ou cole no .env da raiz:
#      cp .env.documentacao.example .env.documentacao
# 2. Crie documentacao-local/ e mova para lá CONTEXT, docs/, apêndice, PDSOB, DEM, DEI, Manual.

MANUCMMS_REPO_ROOT=documentacao-local
MANUCMMS_CONTEXT_FILE=CONTEXT.MD
MANUCMMS_DOCS_DIR=docs
MANUCMMS_APENDICE_MD=APÊNDICE.md
MANUCMMS_APENDICE_HTML=APENDICE-GOOGLE-DOCS.html
MANUCMMS_PDSOB_MD=Cópia de V2.ManuCMMS PDSOB_PDSCOB 2026 - AESA-CESA(1).md
MANUCMMS_PDSOB_HTML=Cópia de V2.ManuCMMS PDSOB_PDSCOB 2026 - AESA-CESA(1).html
MANUCMMS_DEM_MD=3 DOCUMENTO DE ESPECIFICAÇÃO DE MODELAGEM (DEM) .md
MANUCMMS_DEI_MD=4 DOCUMENTO DE ESPECIFICAÇÃO DE INTERFACES (DEI) .md
MANUCMMS_MANUAL_USUARIO_MD=6 MANUAL DO USUÁRIO .md
MANUCMMS_PADRONIZACAO_TCC=docs/PADRONIZACAO-TCC-GOLDEN-RULES.md
MANUCMMS_PLANO_MAESTRO=docs/00-PLANO-MAESTRO.md
MANUCMMS_REGRAS_RN=docs/04-REGRAS-DE-NEGOCIO-E-RASTREABILIDADE.md
MANUCMMS_IOT_ESCOPO=docs/IoT-ESCOPO-DDE.md
MANUCMMS_CURSOR_RULE_TCC=.cursor/rules/padronizacao-tcc.mdc
