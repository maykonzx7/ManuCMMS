# =============================================================================
# ManuCMMS — API NestJS (copiar para backend/.env)
# =============================================================================
#   cp .env.example .env
# Suba antes os serviços: na raiz do repo, `docker compose up -d`.

PORT=3000
NODE_ENV=development
UPLOAD_DIR=uploads
# URL pública da API usada para montar links de upload (fallback: protocolo+host da requisição).
# Exemplo em produção: https://api.exemplo.com
PUBLIC_BASE_URL=

# Frontend autorizado a chamar a API.
# Em produção, separar múltiplas origens por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Para túneis variáveis como ngrok, permitir por sufixo de hostname.
# Exemplo: .ngrok-free.app,.ngrok.app
# CORS_ALLOWED_ORIGIN_SUFFIXES=.ngrok-free.app,.ngrok.app

# --- Supabase Auth (validação de JWT na API — NF-02) ---
# Project URL: Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# JWT Secret: Dashboard → Project Settings → API → JWT Secret (não use anon key como segredo)
SUPABASE_JWT_SECRET=
# Bucket Supabase Storage para fotos de perfil (público; ver supabase/migrations/)
SUPABASE_STORAGE_BUCKET=avatars
# Alternativa de desenvolvimento: se o JWT Secret ainda não estiver configurado,
# a API pode validar o access token consultando o Supabase Auth com a anon key.
SUPABASE_ANON_KEY=cole_a_anon_key_aqui
# Service role (somente backend — convites, reset admin, Supabase Storage)
SUPABASE_SERVICE_ROLE_KEY=

# Primeiro login: cria linha em `usuario` com auth_sub = JWT sub (opcional)
# AUTH_BOOTSTRAP_UNIDADE_ID=<uuid da unidade padrão>
# AUTH_BOOTSTRAP_PERFIL=TECNICO

# --- PostgreSQL ---
# Opção A — Docker local (compose na raiz do repo):
DATABASE_URL=postgresql://manucmms:manucmms_dev@localhost:5432/manucmms
#
# Opção B — Supabase: comente DATABASE_URL acima e preencha (senha = Database password do Dashboard):
# SUPABASE_DB_HOST=db.SEU_PROJECT_REF.supabase.co
# SUPABASE_DB_PASSWORD=sua_senha_do_postgres
# (opcional) SUPABASE_DB_USER=postgres  SUPABASE_DB_NAME=postgres  SUPABASE_DB_PORT=5432
# A URL é montada com ?sslmode=require. Se DATABASE_URL estiver definida, ela tem prioridade.

# MongoDB — trilha de auditoria (authSource=admin com usuário root criado pelo compose)
MONGODB_URI=mongodb://manucmms:manucmms_dev@localhost:27017/manucmms?authSource=admin

# RabbitMQ — AMQP
RABBITMQ_URL=amqp://manucmms:manucmms_dev@localhost:5672/
# Redis — rate limit e operacoes de baixa latencia
REDIS_URL=redis://localhost:6379
# URL de healthcheck do gateway IoT (opcional, usado em /integracoes/status)
IOT_HEALTHCHECK_URL=

# Frontend publico usado nos links de convite.
# Quando usar tunel ngrok, esta URL tem prioridade para os convites.
# Exemplo: https://seu-subdominio.ngrok-free.app
FRONTEND_NGROK_PUBLIC_BASE_URL=
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_ACCESS_PORTAL_PATH=/workspace/acesso
FRONTEND_INVITE_PORTAL_PATH=/workspace/convite
FRONTEND_PLATFORM_PORTAL_PATH=/workspace/platform

# Lista de emails autorizados para fallback de onboarding global.
# Use apenas quando PLATFORM_ALLOW_EMAIL_FALLBACK=true.
# Exemplo: plataforma@manucmms.com,ops@manucmms.com
PLATFORM_OWNER_EMAILS=
# Recomendado manter false: o caminho principal deve ser claim forte
# no token do Supabase (app_metadata.platform_owner=true).
PLATFORM_ALLOW_EMAIL_FALLBACK=false

# Compatibilidade: quando true, permite vincular auth_sub por email na primeira autenticacao.
# Recomendado manter false em producao para exigir fluxo formal de convite.
ALLOW_AUTH_SUB_LINK_BY_EMAIL=false

# Rate limits de endpoints sensiveis (janela deslizante simples em memoria por IP).
RATE_LIMIT_CREATE_EMPRESA_MAX_HITS=10
RATE_LIMIT_CREATE_EMPRESA_WINDOW_MS=60000
RATE_LIMIT_ACCEPT_CONVITE_MAX_HITS=20
RATE_LIMIT_ACCEPT_CONVITE_WINDOW_MS=60000

# SMTP — envio local / VPS (Render FREE bloqueia portas 587/465)
# Para Render/Vercel use BREVO_API_KEY (API HTTPS, porta 443):
# Brevo → SMTP & API → API Keys → Create (prefixo xkeysib-)
# BREVO_API_KEY=xkeysib-...
# BREVO_SMTP_FROM_EMAIL=<email_remetente_validado_no_brevo>
# BREVO_SMTP_FROM_NAME=Equipe ManuCMMS
#
# SMTP legado (funciona em localhost ou Render pago):
# SMTP_PROVIDER=BREVO
# BREVO_SMTP_LOGIN=<seu_login_smtp_brevo>
# BREVO_SMTP_KEY=<sua_chave_smtp_brevo>
# BREVO_SMTP_FROM_EMAIL=<email_remetente_validado>
# Opcional: BREVO_SMTP_FROM_NAME, BREVO_SMTP_HOST, BREVO_SMTP_PORT, BREVO_SMTP_SECURE
SMTP_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@manucmms.local
SMTP_FROM_NAME=Equipe ManuCMMS
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=<brevo_smtp_key>
BREVO_SMTP_FROM_EMAIL=
BREVO_SMTP_FROM_NAME=Equipe ManuCMMS
