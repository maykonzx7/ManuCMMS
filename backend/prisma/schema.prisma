generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  TECNICO
  SUPERVISOR
  GESTOR
  AUDITOR
  ADMIN
}

enum StatusEmpresa {
  ATIVA
  SUSPENSA
  INATIVA
}

enum StatusUsuario {
  ATIVO
  INATIVO
  BLOQUEADO
}

enum StatusUsuarioEmpresa {
  ATIVO
  INATIVO
  PENDENTE
}

enum StatusUnidadeFabril {
  ATIVA
  INATIVA
}

enum StatusConviteAcesso {
  PENDENTE
  ACEITO
  EXPIRADO
  CANCELADO
}

/// DEM: Operacional, Manutenção, Falha.
enum StatusAtivo {
  OPERACIONAL
  MANUTENCAO
  FALHA
  INATIVO
}

/// DEM 3.x — tipos de intervenção.
enum TipoOrdemServico {
  CORRETIVA
  PREVENTIVA
  PREDITIVA
}

/// DEM — ciclo de vida da OS (fechamento com evidências fotográficas: RN-02, RN-13).
enum StatusOrdemServico {
  ABERTA
  AGUARDANDO
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum StatusSlaOrdemServico {
  NO_PRAZO
  ATRASADA
  CONCLUIDA
}

enum PrioridadeOrdemServico {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum TipoAtivoDocumento {
  MANUAL
  DIAGRAMA
  DOCUMENTACAO
}

enum CategoriaOrdemServicoAnexo {
  PROBLEMA
  RESOLUCAO
  GERAL
}

model Empresa {
  id              String           @id @default(uuid()) @db.Uuid
  nomeEmpresa     String           @map("nome_empresa") @db.VarChar(150)
  slug            String           @unique @db.VarChar(120)
  cnpj            String?          @db.VarChar(18)
  cep             String?          @db.VarChar(9)
  endereco        String?          @db.VarChar(255)
  numeroEndereco  String?          @map("numero_endereco") @db.VarChar(20)
  bairro          String?          @db.VarChar(120)
  cidade          String?          @db.VarChar(120)
  estado          String?          @db.VarChar(2)
  contatoNome     String?          @map("contato_nome") @db.VarChar(150)
  contatoEmail    String?          @map("contato_email") @db.VarChar(100)
  contatoTelefone String?          @map("contato_telefone") @db.VarChar(20)
  status          StatusEmpresa    @default(ATIVA)
  webhookUrl      String?          @map("webhook_url") @db.VarChar(500)
  apiKeyIntegracao String?         @unique @map("api_key_integracao") @db.VarChar(64)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  unidades        UnidadeFabril[]
  usuariosEmpresa UsuarioEmpresa[]
  cargos          Cargo[]
  convites        ConviteAcesso[]
  ativos          Ativo[]
  ativoDocumentos AtivoDocumento[]
  ordensServico   OrdemServico[]
  pecas           Peca[]
  integracaoEventos IntegracaoEvento[]

  @@map("empresa")
}

model UnidadeFabril {
  id            String              @id @default(uuid()) @db.Uuid
  empresaId     String?             @map("empresa_id") @db.Uuid
  empresa       Empresa?            @relation(fields: [empresaId], references: [id])
  nome          String              @db.VarChar(100)
  localizacao   String              @db.VarChar(255)
  cep           String?             @db.VarChar(9)
  endereco      String?             @db.VarChar(255)
  numeroEndereco String?            @map("numero_endereco") @db.VarChar(20)
  bairro        String?             @db.VarChar(120)
  cidade        String?             @db.VarChar(120)
  estado        String?             @db.VarChar(2)
  complemento   String?             @db.VarChar(120)
  referencia    String?             @db.VarChar(255)
  slaCorretivaHoras Int             @default(24) @map("sla_corretiva_horas")
  slaPreventivaHoras Int            @default(168) @map("sla_preventiva_horas")
  slaPreditivaHoras Int             @default(72) @map("sla_preditiva_horas")
  status        StatusUnidadeFabril @default(ATIVA)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  usuarios      Usuario[]
  usuariosCargo UsuarioCargo[]
  ativos        Ativo[]
  pecas         Peca[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("unidade_fabril")
}

/// Equipamento monitorado (RF-04); limite térmico por ativo — RN-06 v1.
model Ativo {
  id            String         @id @default(uuid()) @db.Uuid
  empresaId     String?        @map("empresa_id") @db.Uuid
  idUnidade     String         @map("id_unidade") @db.Uuid
  empresa       Empresa?       @relation(fields: [empresaId], references: [id])
  unidade       UnidadeFabril  @relation(fields: [idUnidade], references: [id])
  nome          String         @db.VarChar(100)
  tag           String?        @db.VarChar(80)
  fabricante    String?        @db.VarChar(120)
  modelo        String?        @db.VarChar(120)
  numeroSerie   String?        @map("numero_serie") @db.VarChar(120)
  observacoes   String?        @db.VarChar(500)
  custoHoraParada Float        @default(0) @map("custo_hora_parada")
  custoManutencaoMensal Float  @default(0) @map("custo_manutencao_mensal")
  status        StatusAtivo    @default(OPERACIONAL)
  limiteTemp    Float          @default(48) @map("limite_temp")
  localizacao   String?        @db.VarChar(255)
  latitude      Float?
  longitude     Float?
  fotoUrl       String?        @map("foto_url") @db.VarChar(2048)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  ordensServico OrdemServico[]
  documentos    AtivoDocumento[]

  @@index([empresaId, idUnidade])
  @@index([idUnidade])
  @@map("ativo")
}

model AtivoDocumento {
  id                   String             @id @default(uuid()) @db.Uuid
  empresaId            String             @map("empresa_id") @db.Uuid
  ativoId              String             @map("ativo_id") @db.Uuid
  tipo                 TipoAtivoDocumento
  nome                 String             @db.VarChar(200)
  url                  String             @db.VarChar(2048)
  mimeType             String             @map("mime_type") @db.VarChar(120)
  tamanhoBytes         Int                @map("tamanho_bytes")
  uploadedPorUsuarioId String?            @map("uploaded_por_usuario_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")
  empresa              Empresa            @relation(fields: [empresaId], references: [id])
  ativo                Ativo              @relation(fields: [ativoId], references: [id], onDelete: Cascade)

  @@index([ativoId, tipo])
  @@index([empresaId, ativoId])
  @@map("ativo_documento")
}

/// RF-05 / RF-06 / RF-07; RN-05 (sempre com ativo).
model OrdemServico {
  id                String             @id @default(uuid()) @db.Uuid
  empresaId         String?            @map("empresa_id") @db.Uuid
  idAtivo           String             @map("id_ativo") @db.Uuid
  idTecnico         String?            @map("id_tecnico") @db.Uuid
  criadoPorUsuarioId String?           @map("criado_por_usuario_id") @db.Uuid
  iniciadoPorUsuarioId String?         @map("iniciado_por_usuario_id") @db.Uuid
  finalizadoPorUsuarioId String?       @map("finalizado_por_usuario_id") @db.Uuid
  empresa           Empresa?           @relation(fields: [empresaId], references: [id])
  ativo             Ativo              @relation(fields: [idAtivo], references: [id])
  tecnico           Usuario?           @relation("OsTecnico", fields: [idTecnico], references: [id])
  criadoPorUsuario  Usuario?           @relation("OsCriadaPor", fields: [criadoPorUsuarioId], references: [id])
  iniciadoPorUsuario Usuario?          @relation("OsIniciadaPor", fields: [iniciadoPorUsuarioId], references: [id])
  finalizadoPorUsuario Usuario?        @relation("OsFinalizadaPor", fields: [finalizadoPorUsuarioId], references: [id])
  tipo              TipoOrdemServico
  prioridade        PrioridadeOrdemServico @default(MEDIA)
  status            StatusOrdemServico @default(ABERTA)
  descricao         String             @db.Text
  fotoAnexo         String?            @map("foto_anexo") @db.VarChar(2048)
  /// RN-13 (OS corretiva): evidência do defeito.
  fotoProblema      String?            @map("foto_problema") @db.VarChar(2048)
  descricaoProblema String?            @map("descricao_problema") @db.VarChar(4000)
  /// RN-13 (OS corretiva): evidência da correção.
  fotoSolucao       String?            @map("foto_solucao") @db.VarChar(2048)
  descricaoSolucao  String?            @map("descricao_solucao") @db.VarChar(4000)
  dataLimiteSla     DateTime?          @map("data_limite_sla")
  /// Prazo de vencimento opcional definido na abertura/edição da OS.
  dataPrazoVencimento DateTime?        @map("data_prazo_vencimento")
  /// Data opcional a partir da qual a OS é considerada em atraso (se não informada, usa prazo ou SLA).
  dataLimiteAtraso  DateTime?          @map("data_limite_atraso")
  statusSla         StatusSlaOrdemServico @default(NO_PRAZO) @map("status_sla")
  slaAtrasoNotificadoEm DateTime?      @map("sla_atraso_notificado_em")
  observacaoCancelamento String?       @map("observacao_cancelamento") @db.VarChar(1000)
  assinaturaDigital String?            @map("assinatura_digital") @db.Text
  dataAbertura      DateTime           @default(now()) @map("data_abertura")
  dataFechamento    DateTime?          @map("data_fechamento")
  transferencias    OrdemServicoTransferencia[]
  pecasConsumidas   OrdemServicoPeca[]
  comentarios       OrdemServicoComentario[]
  anexos            OrdemServicoAnexo[]

  @@index([empresaId, status, dataAbertura])
  @@index([idAtivo])
  @@index([idTecnico])
  @@index([criadoPorUsuarioId])
  @@index([iniciadoPorUsuarioId])
  @@index([finalizadoPorUsuarioId])
  @@map("ordem_servico")
}

/// Perfil corporativo local; autenticação fica no Supabase (`auth_sub` = JWT `sub`).
/// `id_unidade` e `perfil` permanecem na fase transitória até a migração de IAM.
model Usuario {
  id                String           @id @default(uuid()) @db.Uuid
  authSub           String           @unique @map("auth_sub")
  idUnidade         String           @map("id_unidade") @db.Uuid
  unidade           UnidadeFabril    @relation(fields: [idUnidade], references: [id])
  nome              String           @db.VarChar(150)
  fotoUrl           String?          @map("foto_url") @db.VarChar(2048)
  credencial        String?          @unique @db.VarChar(60)
  email             String           @unique @db.VarChar(100)
  perfil            PerfilUsuario
  status            StatusUsuario    @default(ATIVO)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  ordensComoTecnico OrdemServico[]   @relation("OsTecnico")
  ordensCriadas     OrdemServico[]   @relation("OsCriadaPor")
  ordensIniciadas   OrdemServico[]   @relation("OsIniciadaPor")
  ordensFinalizadas OrdemServico[]   @relation("OsFinalizadaPor")
  transferenciasRealizadas OrdemServicoTransferencia[] @relation("OsTransferidaPor")
  transferenciasDeTecnico OrdemServicoTransferencia[] @relation("OsTransferenciaDe")
  transferenciasParaTecnico OrdemServicoTransferencia[] @relation("OsTransferenciaPara")
  comentariosOrdemServico OrdemServicoComentario[]
  usuariosEmpresa   UsuarioEmpresa[]
  convitesCriados   ConviteAcesso[]  @relation("ConviteCriadoPor")
  convitesAceitos   ConviteAcesso[]  @relation("ConviteAceitoPor")
  notificacoes      Notificacao[]

  @@map("usuario")
}

model OrdemServicoTransferencia {
  id                   String   @id @default(uuid()) @db.Uuid
  ordemServicoId       String   @map("ordem_servico_id") @db.Uuid
  deTecnicoId          String?  @map("de_tecnico_id") @db.Uuid
  paraTecnicoId        String   @map("para_tecnico_id") @db.Uuid
  transferidoPorUsuarioId String @map("transferido_por_usuario_id") @db.Uuid
  motivo               String   @db.VarChar(2000)
  createdAt            DateTime @default(now()) @map("created_at")
  ordemServico         OrdemServico @relation(fields: [ordemServicoId], references: [id])
  deTecnico            Usuario? @relation("OsTransferenciaDe", fields: [deTecnicoId], references: [id])
  paraTecnico          Usuario  @relation("OsTransferenciaPara", fields: [paraTecnicoId], references: [id])
  transferidoPorUsuario Usuario @relation("OsTransferidaPor", fields: [transferidoPorUsuarioId], references: [id])

  @@index([ordemServicoId, createdAt])
  @@index([paraTecnicoId])
  @@index([transferidoPorUsuarioId])
  @@map("ordem_servico_transferencia")
}

model Peca {
  id                String             @id @default(uuid()) @db.Uuid
  empresaId         String             @map("empresa_id") @db.Uuid
  idUnidade         String             @map("id_unidade") @db.Uuid
  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  unidade           UnidadeFabril      @relation(fields: [idUnidade], references: [id])
  codigo            String             @db.VarChar(80)
  nome              String             @db.VarChar(150)
  quantidadeEstoque Int                @default(0) @map("quantidade_estoque")
  quantidadeMinima  Int                @default(0) @map("quantidade_minima")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  consumos          OrdemServicoPeca[]

  @@unique([empresaId, idUnidade, codigo])
  @@index([empresaId, idUnidade])
  @@map("peca")
}

model OrdemServicoPeca {
  id             String       @id @default(uuid()) @db.Uuid
  ordemServicoId String       @map("ordem_servico_id") @db.Uuid
  pecaId         String       @map("peca_id") @db.Uuid
  quantidade     Int
  createdAt      DateTime     @default(now()) @map("created_at")
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  peca           Peca         @relation(fields: [pecaId], references: [id])

  @@unique([ordemServicoId, pecaId])
  @@index([pecaId])
  @@map("ordem_servico_peca")
}

model OrdemServicoComentario {
  id             String       @id @default(uuid()) @db.Uuid
  ordemServicoId String       @map("ordem_servico_id") @db.Uuid
  usuarioId      String       @map("usuario_id") @db.Uuid
  texto          String       @db.VarChar(2000)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([ordemServicoId, createdAt])
  @@map("ordem_servico_comentario")
}

model OrdemServicoAnexo {
  id                   String                     @id @default(uuid()) @db.Uuid
  empresaId            String                     @map("empresa_id") @db.Uuid
  ordemServicoId       String                     @map("ordem_servico_id") @db.Uuid
  categoria            CategoriaOrdemServicoAnexo
  nome                 String                     @db.VarChar(200)
  url                  String                     @db.VarChar(2048)
  mimeType             String                     @map("mime_type") @db.VarChar(120)
  tamanhoBytes         Int                        @map("tamanho_bytes")
  uploadedPorUsuarioId String?                    @map("uploaded_por_usuario_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at")
  ordemServico         OrdemServico               @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId, categoria])
  @@index([empresaId, ordemServicoId])
  @@map("ordem_servico_anexo")
}

model Notificacao {
  id             String    @id @default(uuid()) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  empresaId      String?   @map("empresa_id") @db.Uuid
  idUnidade      String?   @map("id_unidade") @db.Uuid
  ordemServicoId String?   @map("ordem_servico_id") @db.Uuid
  tipo           String    @db.VarChar(24)
  titulo         String    @db.VarChar(180)
  mensagem       String    @db.VarChar(1000)
  fotoUrl        String?   @map("foto_url") @db.VarChar(2048)
  linkPath       String?   @map("link_path") @db.VarChar(300)
  lidaEm         DateTime? @map("lida_em")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@index([usuarioId, lidaEm])
  @@index([ordemServicoId])
  @@map("notificacao")
}

model UsuarioEmpresa {
  id                     String               @id @default(uuid()) @db.Uuid
  usuarioId              String               @map("usuario_id") @db.Uuid
  empresaId              String               @map("empresa_id") @db.Uuid
  usuario                Usuario              @relation(fields: [usuarioId], references: [id])
  empresa                Empresa              @relation(fields: [empresaId], references: [id])
  status                 StatusUsuarioEmpresa @default(ATIVO)
  isResponsavelPrincipal Boolean              @default(false) @map("is_responsavel_principal")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  cargos                 UsuarioCargo[]

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@map("usuario_empresa")
}

model Cargo {
  id               String           @id @default(uuid()) @db.Uuid
  empresaId        String           @map("empresa_id") @db.Uuid
  empresa          Empresa          @relation(fields: [empresaId], references: [id])
  codigo           String           @db.VarChar(80)
  nome             String           @db.VarChar(120)
  descricao        String?          @db.VarChar(255)
  nivelHierarquico Int              @map("nivel_hierarquico")
  isSistema        Boolean          @default(false) @map("is_sistema")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  permissoes       CargoPermissao[]
  usuariosCargo    UsuarioCargo[]

  @@unique([empresaId, codigo])
  @@index([empresaId, nivelHierarquico])
  @@map("cargo")
}

model Permissao {
  id        String           @id @default(uuid()) @db.Uuid
  codigo    String           @unique @db.VarChar(100)
  nome      String           @db.VarChar(120)
  descricao String?          @db.VarChar(255)
  modulo    String           @db.VarChar(80)
  createdAt DateTime         @default(now()) @map("created_at")
  cargos    CargoPermissao[]

  @@map("permissao")
}

model CargoPermissao {
  cargoId     String    @map("cargo_id") @db.Uuid
  permissaoId String    @map("permissao_id") @db.Uuid
  cargo       Cargo     @relation(fields: [cargoId], references: [id])
  permissao   Permissao @relation(fields: [permissaoId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([cargoId, permissaoId])
  @@map("cargo_permissao")
}

model UsuarioCargo {
  id               String         @id @default(uuid()) @db.Uuid
  usuarioEmpresaId String         @map("usuario_empresa_id") @db.Uuid
  cargoId          String         @map("cargo_id") @db.Uuid
  idUnidade        String?        @map("id_unidade") @db.Uuid
  usuarioEmpresa   UsuarioEmpresa @relation(fields: [usuarioEmpresaId], references: [id])
  cargo            Cargo          @relation(fields: [cargoId], references: [id])
  unidade          UnidadeFabril? @relation(fields: [idUnidade], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([usuarioEmpresaId])
  @@index([cargoId])
  @@index([idUnidade])
  @@map("usuario_cargo")
}

model ConviteAcesso {
  id                    String              @id @default(uuid()) @db.Uuid
  empresaId             String              @map("empresa_id") @db.Uuid
  emailDestino          String              @map("email_destino") @db.VarChar(100)
  cargoCodigo           String              @map("cargo_codigo") @db.VarChar(80)
  idUnidadeDestino      String?             @map("id_unidade_destino") @db.Uuid
  tokenHash             String              @map("token_hash") @db.VarChar(255)
  status                StatusConviteAcesso @default(PENDENTE)
  expiraEm              DateTime            @map("expira_em")
  convidadoPorUsuarioId String?             @map("convidado_por_usuario_id") @db.Uuid
  usuarioCriadoId       String?             @map("usuario_criado_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  empresa               Empresa             @relation(fields: [empresaId], references: [id])
  convidadoPorUsuario   Usuario?            @relation("ConviteCriadoPor", fields: [convidadoPorUsuarioId], references: [id])
  usuarioCriado         Usuario?            @relation("ConviteAceitoPor", fields: [usuarioCriadoId], references: [id])

  @@index([empresaId, status])
  @@index([emailDestino])
  @@map("convite_acesso")
}

model IntegracaoEvento {
  id          String    @id @default(uuid()) @db.Uuid
  empresaId   String    @map("empresa_id") @db.Uuid
  idUnidade   String?   @map("id_unidade") @db.Uuid
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo        String    @db.VarChar(80)
  payload     Json
  status      String    @default("PENDENTE") @db.VarChar(20)
  tentativas  Int       @default(0)
  ultimoErro  String?   @map("ultimo_erro") @db.VarChar(500)
  entregueEm  DateTime? @map("entregue_em")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([empresaId, createdAt(sort: Desc)])
  @@map("integracao_evento")
}
