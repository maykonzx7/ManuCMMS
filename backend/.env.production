# =============================================================================
# ManuCMMS — ambiente para docker-compose.prod local
# =============================================================================

NODE_ENV=production
PORT=3000
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000

# URL pública do frontend autorizada a chamar a API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase Auth ---
# Preencher com valores reais para autenticação JWT.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=cole_o_jwt_secret_do_dashboard_aqui
SUPABASE_ANON_KEY=cole_a_anon_key_aqui

# --- PostgreSQL (container postgres do compose) ---
DATABASE_URL=postgresql://manucmms:manucmms_dev@postgres:5432/manucmms

# --- MongoDB (container mongo do compose) ---
MONGODB_URI=mongodb://manucmms:manucmms_dev@mongo:27017/manucmms?authSource=admin

# --- RabbitMQ (container rabbitmq do compose) ---
RABBITMQ_URL=amqp://manucmms:manucmms_dev@rabbitmq:5672/

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- IoT ---
IOT_HEALTHCHECK_URL=http://localhost:8080/health
