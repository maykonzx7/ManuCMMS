meta {
  name: GET /me com token
  type: http
  seq: 2
  tags: [
    auth
    smoke
  ]
}

get {
  url: {{host}}/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

tests {
  test("deve retornar 403 sem vinculo local", function() {
    expect(res.status).to.equal(403);
  });

  test("deve orientar uso de convite de acesso", function() {
    expect((res.body.message || "").toLowerCase()).to.include("convite");
  });
}
