# =============================================================================
# ManuCMMS — exemplo de ambiente para homologacao / producao
# =============================================================================

NODE_ENV=production
PORT=3000
UPLOAD_DIR=uploads
# URL pública da API para geração das URLs dos arquivos de evidência.
PUBLIC_BASE_URL=https://api.exemplo.com

# URL pública do frontend autorizada a chamar a API.
# Separe múltiplas origens por vírgula.
CORS_ALLOWED_ORIGINS=https://app.exemplo.com

# --- Supabase Auth ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=cole_o_jwt_secret_do_dashboard_aqui
SUPABASE_ANON_KEY=cole_a_anon_key_aqui

# --- PostgreSQL ---
# Em docker-compose.prod local, o compose sobrescreve essa URL automaticamente.
DATABASE_URL=postgresql://manucmms:manucmms_dev@postgres:5432/manucmms
# SUPABASE_DB_HOST=db.SEU_PROJECT_REF.supabase.co
# SUPABASE_DB_PASSWORD=sua_senha_do_postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_PORT=5432

# --- MongoDB ---
# Em docker-compose.prod local, o compose sobrescreve essa URL automaticamente.
MONGODB_URI=mongodb://manucmms:manucmms_dev@mongo:27017/manucmms?authSource=admin

# --- RabbitMQ ---
# Em docker-compose.prod local, o compose sobrescreve essa URL automaticamente.
RABBITMQ_URL=amqp://manucmms:manucmms_dev@rabbitmq:5672/

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- IoT ---
# Endpoint HTTP de health do gateway/simulador IoT.
IOT_HEALTHCHECK_URL=https://iot.exemplo.com/health
