# =============================================================================
# ManuCMMS — exemplo de ambiente para homologacao / producao
# =============================================================================
# Stack Docker local: cp .env.production.example .env.production
# Cloud (Railway/Render): configure as variáveis no painel do provedor.
# docker-compose.prod.yml sobrescreve DATABASE_URL, MONGODB_URI, RABBITMQ_URL e REDIS_URL.

NODE_ENV=production
PORT=3000
UPLOAD_DIR=uploads

# URL pública da API (links de upload de evidência).
PUBLIC_BASE_URL=https://SUA-API.onrender.com

# Frontend público (convites, emails de OS, links de notificação).
FRONTEND_PUBLIC_BASE_URL=https://SEU-APP.vercel.app
FRONTEND_ACCESS_PORTAL_PATH=/workspace/acesso
FRONTEND_INVITE_PORTAL_PATH=/workspace/convite
FRONTEND_PLATFORM_PORTAL_PATH=/workspace/platform

# CORS — origens exatas + sufixo para previews Vercel.
CORS_ALLOWED_ORIGINS=https://SEU-APP.vercel.app
CORS_ALLOWED_ORIGIN_SUFFIXES=.vercel.app

# --- Supabase Auth ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=cole_o_jwt_secret_do_dashboard_aqui
SUPABASE_ANON_KEY=cole_a_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

# --- PostgreSQL (compose local sobrescreve; cloud: Supabase pooler Session) ---
# Render/cloud: use Connection pooling → Session (NÃO db.xxx.supabase.co direto):
# DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:[SENHA]@aws-0-XX.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://manucmms:manucmms_prod@postgres:5432/manucmms

# --- MongoDB (compose local sobrescreve; cloud: Atlas M0) ---
MONGODB_URI=mongodb://manucmms:manucmms_prod@mongo:27017/manucmms?authSource=admin

# --- RabbitMQ (compose local sobrescreve; cloud: CloudAMQP) ---
RABBITMQ_URL=amqp://manucmms:manucmms_prod@rabbitmq:5672/

# --- Redis (compose local sobrescreve; cloud: Upstash) ---
REDIS_URL=redis://redis:6379

# --- Microserviço IoT (Render: manucmms-iot-ingestion) ---
IOT_HEALTHCHECK_URL=https://manucmms-iot-ingestion.onrender.com/health
IOT_INGESTION_URL=https://manucmms-iot-ingestion.onrender.com

# --- Plataforma / onboarding ---
PLATFORM_ALLOW_EMAIL_FALLBACK=false
PLATFORM_OWNER_EMAILS=plataforma@exemplo.com
ALLOW_AUTH_SUB_LINK_BY_EMAIL=false

# --- SMTP (convites e notificações por email) ---
# SMTP_PROVIDER=BREVO
# BREVO_SMTP_LOGIN=
# BREVO_SMTP_KEY=
# BREVO_SMTP_FROM_EMAIL=
