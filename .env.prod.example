# =============================================================================
# ManuCMMS — variáveis para docker-compose.prod.yml (raiz do repositório)
# =============================================================================
# Copie para .env.prod na raiz:
#   cp .env.prod.example .env.prod
# Use com: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# --- Credenciais dos serviços (altere em homolog/prod real) ---
POSTGRES_USER=manucmms
POSTGRES_PASSWORD=manucmms_prod
POSTGRES_DB=manucmms

MONGO_INITDB_ROOT_USERNAME=manucmms
MONGO_INITDB_ROOT_PASSWORD=manucmms_prod

RABBITMQ_DEFAULT_USER=manucmms
RABBITMQ_DEFAULT_PASS=manucmms_prod

# --- Portas expostas no host ---
# Use 3002 se o backend de dev já ocupar 3000.
API_PORT=3002
RABBITMQ_MANAGEMENT_PORT=15672

# --- URLs públicas (preencher após deploy Vercel/Railway) ---
# Usadas em scripts/homolog/check-homolog.sh e coleta NF.
# API_BASE_URL=https://SUA-API.railway.app
# FRONTEND_BASE_URL=https://SEU-APP.vercel.app
